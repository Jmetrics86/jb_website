---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Jason Brewster | Analytics & Marketing Science">
    <main class="max-w-4xl mx-auto px-6 py-20">
        <!-- Hero Section with subtle entrance -->
        <header class="mb-24">
            <h1 class="text-6xl md:text-8xl font-black tracking-tighter text-slate-900 mb-6 leading-none">
                Jason <br />Brewster
            </h1>
            <p class="text-2xl text-slate-500 font-medium tracking-tight">
                Data-driven marketing leader. <br />
                <span class="text-blue-600">Architecting AI & Analytics ecosystems.</span>
            </p>
        </header>

        <!-- Platform & Skills Grid -->
        <section class="mb-24">
            <h2 class="text-xs uppercase tracking-widest text-slate-400 font-bold mb-8">Expertise & Platforms</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <!-- BigQuery / Google Cloud -->
                <div class="group p-6 rounded-2xl bg-white border border-slate-200 hover:border-blue-200 hover:shadow-md transition-all flex flex-col items-center justify-center text-center">
                    <svg class="h-10 w-10 text-slate-400 group-hover:text-blue-600 transition-colors mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75" />
                    </svg>
                    <span class="font-bold text-sm text-slate-800">BigQuery</span>
                    <span class="text-xs text-slate-400 mt-1">Data Warehousing</span>
                </div>

                <!-- Google Analytics & GTM -->
                <div class="group p-6 rounded-2xl bg-white border border-slate-200 hover:border-blue-200 hover:shadow-md transition-all flex flex-col items-center justify-center text-center">
                    <svg class="h-10 w-10 text-slate-400 group-hover:text-amber-500 transition-colors mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                    </svg>
                    <span class="font-bold text-sm text-slate-800">Google Analytics</span>
                    <span class="text-xs text-slate-400 mt-1">Measurement</span>
                </div>

                <!-- Python / Machine Learning -->
                <div class="group p-6 rounded-2xl bg-white border border-slate-200 hover:border-blue-200 hover:shadow-md transition-all flex flex-col items-center justify-center text-center">
                    <svg class="h-10 w-10 text-slate-400 group-hover:text-green-600 transition-colors mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
                    </svg>
                    <span class="font-bold text-sm text-slate-800">Python & ML</span>
                    <span class="text-xs text-slate-400 mt-1">Modeling</span>
                </div>

                <!-- AI / Automation -->
                <div class="group p-6 rounded-2xl bg-white border border-slate-200 hover:border-blue-200 hover:shadow-md transition-all flex flex-col items-center justify-center text-center">
                    <svg class="h-10 w-10 text-slate-400 group-hover:text-purple-600 transition-colors mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21l3.593-1.632m4.594-3.464L18 21l-3.593-1.632m-4.594-3.464a9.003 9.003 0 0110.455-10.455 9.003 9.003 0 01-10.455 10.455z" />
                    </svg>
                    <span class="font-bold text-sm text-slate-800">AI / NLP</span>
                    <span class="text-xs text-slate-400 mt-1">Marketing Science</span>
                </div>
            </div>
        </section>

        <!-- Bento Grid with Interactive Hover -->
        <section class="mb-24">
            <h2 class="text-xs uppercase tracking-widest text-slate-400 font-bold mb-8">Selected Projects</h2>
            <div class="grid md:grid-cols-3 gap-4 auto-rows-[250px]">
                <!-- Main Project Card -->
                <div class="group md:col-span-2 p-8 rounded-3xl bg-white border border-slate-200 shadow-sm hover:shadow-xl hover:border-blue-200 transition-all duration-300 flex flex-col justify-end">
                    <h3 class="text-3xl font-bold mb-2 group-hover:text-blue-600 transition-colors">Personal Data Dashboard</h3>
                    <p class="text-slate-600">End-to-end analytics platform visualizing marketing metrics using BigQuery.</p>
                </div>
                <!-- Secondary Card -->
                <div class="p-8 rounded-3xl bg-blue-600 text-white flex flex-col justify-between shadow-lg shadow-blue-200">
                    <h3 class="text-2xl font-bold">AI Marketing Utility</h3>
                    <span class="text-blue-100 opacity-80 uppercase tracking-widest text-xs font-bold">NLP Integration</span>
                </div>
                <!-- Tertiary Card -->
                <div class="md:col-span-3 p-8 rounded-3xl bg-slate-900 text-white flex items-center justify-between">
                    <h3 class="text-xl font-bold">Driving revenue through operational efficiency</h3>
                    <div class="flex gap-4">
                        <a href="/demos" class="px-6 py-3 bg-blue-600 text-white rounded-full font-bold hover:bg-blue-700 transition-colors">
                            View Live Demos
                        </a>
                        <a href="#" class="px-6 py-3 bg-white text-slate-900 rounded-full font-bold hover:bg-slate-200 transition-colors">
                            View Resume
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Experience Timeline -->
        <section class="border-t border-slate-200 pt-16">
            <h2 class="text-xs uppercase tracking-widest text-slate-400 font-bold mb-10">Career Highlights</h2>
            <div class="relative border-l border-slate-200 ml-2 space-y-12">
                <div class="relative pl-8">
                    <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-blue-500"></span>
                    <h3 class="font-bold text-lg">SVP, Marketing Analytics @ Zimmerman</h3>
                    <p class="text-slate-500">2024–Present</p>
                </div>
                <div class="relative pl-8">
                    <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-slate-300"></span>
                    <h3 class="font-bold text-lg">VP, Head of Analytics @ Zimmerman</h3>
                    <p class="text-slate-500">2018–2024</p>
                </div>
            </div>
        </section>
    </main>
</Layout>
