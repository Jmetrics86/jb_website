---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Jason Brewster - Marketing Analytics Leader">
    <main class="max-w-3xl mx-auto px-6 py-12 md:py-20">
        <header class="mb-16">
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900 mb-4">
                Jason Brewster
            </h1>
            <p class="text-xl md:text-2xl text-gray-600 font-light">
                SVP, Head of Analytics & Marketing Science Leader
            </p>
        </header>

        <section class="mb-12">
            <h2 class="text-2xl font-semibold text-gray-800 mb-4">Summary</h2>
            <p class="text-gray-700 leading-relaxed">
                Data-driven marketing leader with a firm belief in the Kaizen philosophy of continuous improvement, achieving 1% progress every day. Extensive experience in driving revenue growth through insightful analytics and operational efficiencies. Proven track record of success in lead analytics roles, elevating sales for major brands like Planet Fitness, McDonald's, Five Below, and more.
            </p>
        </section>

        <section class="mb-12">
            <h2 class="text-2xl font-semibold text-gray-800 mb-6">Experience</h2>
            <div class="space-y-6">
                <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                    <h3 class="font-bold text-lg text-gray-900">Senior Vice President, Marketing Analytics</h3>
                    <p class="text-gray-600">Zimmerman Advertising • 2024–Present</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                    <h3 class="font-bold text-lg text-gray-900">VP, Head of Analytics</h3>
                    <p class="text-gray-600">Zimmerman Advertising • 2018–2024</p>
                </div>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-semibold text-gray-800 mb-6">Projects</h2>
            <div class="grid md:grid-cols-2 gap-6">
                <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                    <h3 class="font-bold text-gray-900 mb-2">Personal Data Dashboard</h3>
                    <p class="text-sm text-gray-600 mb-4">Visualizing marketing metrics using BigQuery.</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                    <h3 class="font-bold text-gray-900 mb-2">AI Marketing Utility</h3>
                    <p class="text-sm text-gray-600 mb-4">Demonstrating AI integration for SEO/Content analysis.</p>
                </div>
            </div>
        </section>
    </main>
</Layout>
